---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Acceso administrativo · Refugio">
  <main class="grid min-h-screen lg:grid-cols-2">
    <section class="relative hidden overflow-hidden bg-teal-900 p-10 text-white lg:flex lg:flex-col lg:justify-between">
      <a href="/" class="flex items-center gap-2 text-sm font-extrabold">✦ refugio<span class="text-sun-500">.</span></a>
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[.25em] text-sun-500">Panel privado</p>
        <h1 class="max-w-md font-display text-7xl leading-[.9]">Cuidar también es organizar.</h1>
        <p class="mt-7 max-w-sm text-sm leading-7 text-white/65">Administra la información de cada animal y ayúdanos a encontrarle un hogar.</p>
      </div>
      <p class="text-xs text-white/40">Huellas que encuentran hogar.</p>
    </section>
    <section class="flex items-center justify-center bg-slate-50 px-6 py-16">
      <div class="w-full max-w-md">
        <a href="/" class="mb-16 inline-flex text-sm font-extrabold text-ink lg:hidden">✦ refugio<span class="text-sun-500">.</span></a>
        <p class="text-xs font-bold uppercase tracking-[.2em] text-teal-800">Bienvenido de vuelta</p>
        <h1 class="mt-3 font-display text-5xl">Iniciar sesión</h1>
        <p class="mt-4 text-sm text-slate-500">Ingresa para administrar los animales del refugio.</p>
        <form id="login-form" class="mt-10 space-y-5">
          <label class="label">Usuario<input class="field" name="usuario" autocomplete="username" required /></label>
          <label class="label">Contraseña<input class="field" name="contrasena" type="password" autocomplete="current-password" required /></label>
          <p id="login-error" class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></p>
          <button class="button-primary w-full" type="submit">Entrar al panel</button>
        </form>
        <a href="/" class="mt-8 block text-center text-xs font-bold text-slate-500 hover:text-teal-800">← Volver al inicio</a>
      </div>
    </section>
  </main>
  <script src="../scripts/login.ts"></script>
</MainLayout>
