---
import MainLayout from '../../../layouts/MainLayout.astro';
---
<MainLayout title="Animales · Administración">
  <main class="min-h-screen bg-slate-50"><header class="border-b border-slate-200 bg-white"><div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10"><a href="/" class="text-sm font-extrabold text-ink">✦ refugio<span class="text-sun-500">.</span></a><div class="flex items-center gap-4"><span class="hidden text-xs text-slate-400 sm:inline">Sesión de administrador</span><button id="logout" class="text-xs font-bold text-teal-900 hover:text-sun-500">Cerrar sesión</button></div></div></header><section class="mx-auto max-w-7xl px-6 py-12 lg:px-10"><div class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-xs font-bold uppercase tracking-[.2em] text-teal-800">Panel de control</p><h1 class="mt-2 font-display text-5xl">Nuestros animales</h1><p class="mt-3 text-sm text-slate-500">Administra los residentes del refugio.</p></div><a href="/admin/animals/new" class="button-primary">+ Registrar animal</a></div><div class="mt-10 rounded-3xl bg-white p-5 shadow-soft"><div class="grid gap-3 md:grid-cols-5"><input id="filter-nombre" class="field mt-0" placeholder="Buscar por nombre" /><input id="filter-raza" class="field mt-0" placeholder="Raza" /><select id="filter-sexo" class="field mt-0"><option value="">Todos los sexos</option><option>Hembra</option><option>Macho</option></select><select id="filter-tipoAnimal" class="field mt-0"><option value="">Todos los tipos</option><option>Perro</option><option>Gato</option></select><button id="filter-button" class="rounded-xl bg-teal-900 px-5 py-3 text-sm font-bold text-white hover:bg-teal-800">Filtrar</button></div></div><div id="list-error" class="mt-5 hidden rounded-2xl bg-red-50 p-4 text-sm text-red-700"></div><div id="animal-list" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div></section></main>
  <script src="../../../scripts/animal-list.ts"></script>
</MainLayout>
