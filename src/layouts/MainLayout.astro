---
import '../styles/global.css';
const { title = 'Refugio · Huellas que encuentran hogar' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Refugio de animales: cuidamos, protegemos y conectamos mascotas con nuevos hogares." />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
